# ==========================================
# Security & Sensitive Files (CRITICAL)
# ==========================================
# SSL/TLS certificates and private keys
certs/
*.pem
*.key
*.crt

# Environment variables & secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Local Databases & storage
*.sqlite
*.sqlite3
*.db
backend/database.sqlite

# User Uploaded files (keep directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Dependencies & Build Output
# ==========================================
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
build/
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & Editor Specific Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
