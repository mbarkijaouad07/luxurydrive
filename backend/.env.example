PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=car_rental_pro
# Set to 'sqlite' for local development or 'mysql' for production
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# JWT Secret - generate a secure random string in production
JWT_SECRET=replace_with_a_secure_random_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Client URL (Vite frontend)
CLIENT_URL=https://localhost:5173
